# Seules les variables utiles sont listées ; les autres ont une valeur par défaut (voir README).

# ─── Base de données
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/yameogo?schema=public"

# ─── Adresses (sans / final)
# Prod : https://yameogo.vercel.app, https://yameogo-admin.vercel.app, https://yameogo-backend.onrender.com
WEB_ORIGIN="http://localhost:3100"
ADMIN_ORIGIN="http://localhost:3101"
API_PUBLIC_URL="http://localhost:4100"

# ─── Secrets
# APP_SECRET : openssl rand -base64 48 — signe les sessions et les codes d'avis.
APP_SECRET="change-me-with-a-long-random-value"
# DATA_ENCRYPTION_KEY : openssl rand -base64 32 — chiffre les codes d'avis conservés. Ne jamais la changer.
DATA_ENCRYPTION_KEY="base64-32-bytes"

# ─── Premier compte Responsable (utilisé uniquement par `pnpm db:seed`)
SEED_MANAGER_EMAIL="responsable@example.com"
SEED_MANAGER_NAME="Responsable"
SEED_MANAGER_PASSWORD=""

# ─── Production uniquement (déjà réglées dans render.yaml)
# NODE_ENV=production
# COOKIE_SECURE=true
# TRUST_PROXY=2

# ─── Photos : Cloudflare R2 (obligatoire en production, sinon les photos sont perdues à chaque déploiement)
# Vide = photos sur le disque (développement). Cloudflare › R2 › « Gérer les jetons API » (Object Read & Write).
# R2_ACCOUNT_ID=""            # identifiant de compte Cloudflare (32 caractères)
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="yameogo-images"  # bucket des photos, avec accès public activé
# R2_PUBLIC_URL=""            # https://pub-….r2.dev ou votre domaine (ex. https://images.votredomaine.com)
# R2_PRIVATE_BUCKET="yameogo-prive"  # recommandé : justificatifs de dépenses, sans accès public

# ─── Facultatif : paiement TMoney / Flooz en ligne (PayGate Global)
# PAYGATE_API_KEY=""
