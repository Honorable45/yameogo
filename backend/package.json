{
  "name": "@yameogo/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:prod": "prisma migrate deploy && node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:demo:clear": "tsx prisma/seed-demo.ts --clear",
    "import:catalogue": "tsx --env-file=.env prisma/import-catalogue.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=src/",
    "test:int": "jest --runInBand --testPathPattern=test/"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3",
    "@date-fns/tz": "1",
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/throttler": "6.4.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "cookie-parser": "1.4.7",
    "date-fns": "4",
    "helmet": "8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11",
    "@nestjs/testing": "11.1.29",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "5",
    "@types/jest": "29",
    "@types/multer": "^2.3.0",
    "@types/node": "22",
    "@types/supertest": "6",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7",
    "ts-jest": "29.4.5",
    "tsx": "4",
    "typescript": "5.9.3"
  }
}
