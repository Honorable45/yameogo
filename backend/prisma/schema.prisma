// Le Marchand — modèle de données
//
// Conventions :
// - Montants en francs CFA (XOF), stockés en entiers (le XOF n'a pas de subdivision).
// - Dates stockées en UTC ; les périodes statistiques sont calculées dans le fuseau BUSINESS_TIMEZONE.
// - Les opérations financières validées ne sont jamais supprimées : elles sont annulées
//   (statut + motif) ou corrigées par une nouvelle écriture.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Utilisateurs & sécurité

enum Role {
  MANAGER // Responsable
  SELLER // Vendeur
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions         Session[]
  auditLogs        AuditLog[]
  orderHistory     OrderStatusHistory[]
  createdOrders    Order[]                   @relation("OrderCreatedBy")
  payments         Payment[]
  movements        InventoryMovement[]
  expenses         Expense[]                 @relation("ExpenseCreatedBy")
  voidedExpenses   Expense[]                 @relation("ExpenseVoidedBy")
  purchases        Purchase[]                @relation("PurchaseCreatedBy")
  reviewTokens     ReviewVerificationToken[]
  moderatedReviews Review[]
  inventoryCounts  InventoryCount[]
  orderReturns     OrderReturn[]
  purchasePayments PurchasePayment[]
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  summary   String
  // Détails techniques de l'opération (valeurs avant/après) — usage journal uniquement.
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// Compteurs pour les numéros lisibles (C-2026-00001, A-2026-0001…)
model Counter {
  key   String @id
  value Int
}

// ───────────────────────────── Paramètres de la boutique

model BusinessSettings {
  id                    Int      @id @default(1)
  shopName              String   @default("Le Marchand")
  tagline               String?
  logoUrl               String?
  heroImageUrl          String?
  heroImageAlt          String?
  phonesImageUrl        String?
  phonesImageAlt        String?
  shopImageUrl          String?
  shopImageAlt          String?
  tiktokUrl             String?
  instagramUrl          String?
  facebookUrl           String?
  phone                 String?
  whatsapp              String?
  email                 String?
  addressLine           String?
  city                  String?
  country               String?
  mapUrl                String?
  // Position GPS de la boutique (carte et itinéraire sur le site).
  latitude              Float?
  longitude             Float?
  legalName             String?
  legalForm             String?
  registrationNumber    String?
  taxId                 String?
  publicationDirector   String?
  hostingProvider       String?
  deliveryEnabled       Boolean  @default(false)
  deliveryFee           Int      @default(0)
  deliveryArea          String?
  // Texte libre affiché sur le site : zones, délais, frais de livraison.
  deliveryInfo          String?
  cashOnDeliveryEnabled Boolean  @default(false)
  payInStoreEnabled     Boolean  @default(true)
  mobileMoneyEnabled    Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

model OpeningHour {
  id        Int     @id @default(autoincrement())
  // 1 = lundi … 7 = dimanche (ISO 8601)
  dayOfWeek Int     @unique
  closed    Boolean @default(false)
  opensAt   String? // "08:00"
  closesAt  String? // "19:30"
}

// ───────────────────────────── Clients

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique // format normalisé (chiffres, préfixe + conservé)
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

// ───────────────────────────── Catalogue
//
// Une fiche (ProductGroup) est ce que le client consulte : « Samsung Galaxy A56 », « Câble USB-C ».
// Chaque variante vendable (couleur, RAM, stockage, état, option) est un article (Product) avec
// son propre prix, son stock et son coût : stock, caisse, ventes et statistiques travaillent par article.

enum ProductKind {
  PHONE // smartphone
  ACCESSORY
}

enum PhoneCondition {
  NEW // Neuf
  USED // Occasion
}

model Brand {
  id       String         @id @default(cuid())
  name     String         @unique
  slug     String         @unique
  position Int            @default(0)
  active   Boolean        @default(true)
  groups   ProductGroup[]
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

model Category {
  id          String         @id @default(cuid())
  kind        ProductKind    @default(ACCESSORY)
  name        String
  slug        String         @unique
  description String?
  position    Int            @default(0)
  active      Boolean        @default(true)
  products    Product[]
  groups      ProductGroup[]
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  products  Product[]
  purchases Purchase[]
}

model ProductGroup {
  id             String        @id @default(cuid())
  kind           ProductKind
  name           String
  slug           String        @unique
  // Marque (smartphones ; facultative pour les accessoires).
  brandId        String?
  brand          Brand?        @relation(fields: [brandId], references: [id])
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  description    String        @default("")
  // Caractéristiques techniques : [{ "label": "Écran", "value": "6,6 pouces AMOLED" }, …]
  specs          Json          @default("[]")
  // Nom de l'option libre des variantes (ex. « Longueur », « Modèle compatible ») ; null si non utilisée.
  optionName     String?
  // Compatibilité affichée sur la fiche (accessoires) : « iPhone 13, iPhone 14 ».
  compatibleWith String?
  published      Boolean       @default(true)
  featured       Boolean       @default(false)
  status         ProductStatus @default(ACTIVE)
  isDemo         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  variants Product[]
  images   ProductImage[]

  @@index([kind, status, published])
  @@index([brandId])
}

// Article vendable = une variante d'une fiche.
model Product {
  id                String          @id @default(cuid())
  kind              ProductKind     @default(ACCESSORY)
  groupId           String
  group             ProductGroup    @relation(fields: [groupId], references: [id])
  // Attributs de la variante (null = sans objet pour ce produit).
  color             String?
  // Pastille de couleur (#RRGGBB).
  colorHex          String?
  ramGb             Int?
  storageGb         Int?
  condition         PhoneCondition?
  optionValue       String?
  // Prix barré (promotion) : supérieur au prix de vente quand il est renseigné.
  compareAtPrice    Int?
  position          Int             @default(0)
  sku               String          @unique
  slug              String          @unique
  name              String
  description       String          @default("")
  categoryId        String
  category          Category        @relation(fields: [categoryId], references: [id])
  supplierId        String?
  supplier          Supplier?       @relation(fields: [supplierId], references: [id])
  salePrice         Int
  // Coût moyen pondéré courant (XOF). Mis à jour à chaque entrée en stock valorisée.
  averageCost       Int             @default(0)
  // Quantité physiquement présente en boutique.
  stockQuantity     Int             @default(0)
  // Quantité réservée par des commandes non terminées. Disponible = stock - réservé.
  reservedQuantity  Int             @default(0)
  lowStockThreshold Int             @default(2)
  status            ProductStatus   @default(ACTIVE)
  // Visible sur le site public (accessoires uniquement).
  published         Boolean         @default(true)
  // Données de démonstration (environnement de développement).
  isDemo            Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  movements     InventoryMovement[]
  orderItems    OrderItem[]
  purchaseItems PurchaseItem[]
  countLines    InventoryCountLine[]

  @@index([kind, status, published])
  @@index([categoryId])
  @@index([groupId, position])
}

model ProductImage {
  id         String       @id @default(cuid())
  groupId    String
  group      ProductGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // Couleur illustrée (affichée en premier quand le client choisit cette couleur).
  color      String?
  // URL externe, ou clé de stockage (images téléversées, déclinées en plusieurs largeurs).
  url        String?
  storageKey String?
  alt        String       @default("")
  position   Int          @default(0)
  width      Int?
  height     Int?

  @@index([groupId, position])
}

// ───────────────────────────── Stocks

enum MovementType {
  INITIAL // stock initial
  PURCHASE // réception d'un approvisionnement
  PURCHASE_CANCEL // annulation d'un approvisionnement validé
  SALE // sortie à la vente (commande terminée)
  SALE_RETURN // retour client remis en stock
  ADJUSTMENT // correction manuelle justifiée
  COUNT // correction issue d'un inventaire
}

model InventoryMovement {
  id               String       @id @default(cuid())
  productId        String
  product          Product      @relation(fields: [productId], references: [id])
  type             MovementType
  // Quantité signée : positive = entrée, négative = sortie.
  quantity         Int
  // Coût unitaire valorisant ce mouvement (XOF).
  unitCost         Int
  stockAfter       Int
  averageCostAfter Int
  reason           String?
  purchaseItemId   String?
  orderItemId      String?
  orderReturnId    String?
  countLineId      String?
  userId           String?
  user             User?        @relation(fields: [userId], references: [id])
  createdAt        DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([type, createdAt])
}

model InventoryCount {
  id          String               @id @default(cuid())
  note        String?
  createdById String
  createdBy   User                 @relation(fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())
  lines       InventoryCountLine[]
}

model InventoryCountLine {
  id         String         @id @default(cuid())
  countId    String
  count      InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId  String
  product    Product        @relation(fields: [productId], references: [id])
  expected   Int
  counted    Int
  difference Int
  note       String?

  @@index([productId])
}

// ───────────────────────────── Approvisionnements

enum PurchaseStatus {
  DRAFT
  VALIDATED
  CANCELLED
}

enum SettlementStatus {
  UNPAID
  PARTIAL
  PAID
}

model Purchase {
  id            String           @id @default(cuid())
  number        String           @unique
  supplierId    String
  supplier      Supplier         @relation(fields: [supplierId], references: [id])
  invoiceNumber String?
  purchaseDate  DateTime
  status        PurchaseStatus   @default(DRAFT)
  itemsTotal    Int              @default(0)
  // Frais annexes (transport, douane…) répartis au prorata de la valeur des lignes.
  extraCosts    Int              @default(0)
  total         Int              @default(0)
  amountPaid    Int              @default(0)
  paymentStatus SettlementStatus @default(UNPAID)
  note          String?
  createdById   String
  createdBy     User             @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  validatedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  items    PurchaseItem[]
  payments PurchasePayment[]

  @@index([status, purchaseDate])
}

model PurchaseItem {
  id             String   @id @default(cuid())
  purchaseId     String
  purchase       Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  quantity       Int
  unitCost       Int
  lineTotal      Int
  allocatedExtra Int      @default(0)
  landedUnitCost Int      @default(0)
}

model PurchasePayment {
  id           String        @id @default(cuid())
  purchaseId   String
  purchase     Purchase      @relation(fields: [purchaseId], references: [id])
  amount       Int
  method       PaymentMethod
  paidAt       DateTime
  note         String?
  cancelledAt  DateTime?
  cancelReason String?
  recordedById String
  recordedBy   User          @relation(fields: [recordedById], references: [id])
  createdAt    DateTime      @default(now())
}

enum OrderStatus {
  PENDING // En attente de confirmation
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum OrderChannel {
  ONLINE
  IN_STORE
}

enum FulfillmentMethod {
  PICKUP
  DELIVERY
}

enum PaymentPreference {
  PAY_IN_STORE
  CASH_ON_DELIVERY
  TMONEY
  FLOOZ
}

model Order {
  id                String            @id @default(cuid())
  number            String            @unique
  // Jeton aléatoire permettant au client de consulter sa commande.
  accessToken       String            @unique
  channel           OrderChannel
  status            OrderStatus       @default(PENDING)
  customerId        String?
  customer          Customer?         @relation(fields: [customerId], references: [id])
  customerName      String
  customerPhone     String
  fulfillment       FulfillmentMethod @default(PICKUP)
  deliveryAddress   String?
  paymentPreference PaymentPreference
  comment           String?
  subtotal          Int
  deliveryFee       Int               @default(0)
  total             Int
  amountPaid        Int               @default(0)
  paymentStatus     SettlementStatus  @default(UNPAID)
  confirmedAt       DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  createdById       String?
  createdBy         User?             @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items        OrderItem[]
  payments     Payment[]
  history      OrderStatusHistory[]
  review       Review?
  reviewTokens ReviewVerificationToken[]
  returns      OrderReturn[]

  @@index([status, createdAt])
  @@index([completedAt])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  label            String
  sku              String
  quantity         Int
  unitPrice        Int
  lineTotal        Int
  // Coût unitaire figé lors de la sortie de stock (coût moyen de l'article).
  unitCost         Int?
  returnedQuantity Int     @default(0)

  @@index([productId])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  userId     String?
  user       User?        @relation(fields: [userId], references: [id])
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

// Retour d'articles après une vente terminée : annule le chiffre d'affaires
// et, si l'article est remis en stock, le coût correspondant.
model OrderReturn {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  orderItemId String
  quantity    Int
  amount      Int
  costAmount  Int
  restocked   Boolean
  reason      String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ───────────────────────────── Paiements (ventes)

enum PaymentMethod {
  CASH
  TMONEY
  FLOOZ
  CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentKind {
  PAYMENT
  REFUND
}

enum PaymentStatus {
  PENDING // initié auprès d'un prestataire, non confirmé
  CONFIRMED
  FAILED
  CANCELLED // écriture annulée (correction)
}

model Payment {
  id                String        @id @default(cuid())
  kind              PaymentKind   @default(PAYMENT)
  method            PaymentMethod
  status            PaymentStatus
  // Toujours positif ; le sens est donné par `kind`.
  amount            Int
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  // MANUAL (saisi par l'équipe) ou nom du prestataire (PAYGATE…)
  provider          String        @default("MANUAL")
  providerReference String?
  // Référence de transaction communiquée par le client ou l'opérateur.
  externalReference String?
  payerPhone        String?
  note              String?
  confirmedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  recordedById      String?
  recordedBy        User?         @relation(fields: [recordedById], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([provider, providerReference])
  @@index([status, confirmedAt])
  @@index([orderId])
}

// ───────────────────────────── Dépenses générales

enum ExpenseCategory {
  RENT
  ELECTRICITY
  INTERNET
  TRANSPORT
  SALARIES
  EQUIPMENT_MAINTENANCE
  SUPPLIES
  OTHER
}

enum ExpenseStatus {
  ACTIVE
  VOIDED
}

model Expense {
  id            String          @id @default(cuid())
  label         String
  category      ExpenseCategory
  amount        Int
  expenseDate   DateTime
  paymentMethod PaymentMethod
  receiptKey    String?
  comment       String?
  status        ExpenseStatus   @default(ACTIVE)
  voidedAt      DateTime?
  voidReason    String?
  voidedById    String?
  voidedBy      User?           @relation("ExpenseVoidedBy", fields: [voidedById], references: [id])
  // Correction : la nouvelle écriture référence celle qu'elle remplace.
  replacesId    String?         @unique
  replaces      Expense?        @relation("ExpenseCorrection", fields: [replacesId], references: [id])
  replacedBy    Expense?        @relation("ExpenseCorrection")
  createdById   String
  createdBy     User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())

  @@index([status, expenseDate])
}

// ───────────────────────────── Avis clients

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  FLAGGED
}

enum ReviewService {
  ACCESSORY_PURCHASE
  PHONE_PURCHASE
  OTHER
}

model Review {
  id             String        @id @default(cuid())
  rating         Int
  ratingWelcome  Int?
  ratingValue    Int?
  comment        String?
  // Prénom ou pseudonyme facultatif choisi par le client.
  displayName    String?
  serviceType    ReviewService
  status         ReviewStatus  @default(PENDING)
  verified       Boolean       @default(false)
  // Une vente ne peut porter qu'un seul avis.
  orderId        String?       @unique
  order          Order?        @relation(fields: [orderId], references: [id])
  moderatedAt    DateTime?
  moderatedById  String?
  moderatedBy    User?         @relation(fields: [moderatedById], references: [id])
  moderationNote String?
  // Réponse publique de la boutique (le contenu du client n'est jamais modifié).
  shopReply      String?
  ipHash         String?
  createdAt      DateTime      @default(now())

  @@index([status, createdAt])
}

/// Code d'avis : remis au client pour chaque vente ; sans code, pas d'avis.
model ReviewVerificationToken {
  id            String    @id @default(cuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id])
  // Empreinte HMAC du code (recherche) ; le code est aussi conservé chiffré pour rester affichable dans l'administration.
  codeHash      String    @unique
  codeEncrypted String?
  createdById   String
  createdBy     User      @relation(fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  usedAt        DateTime?

  @@index([orderId])
}
